{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!apps/api/drizzle",
      "!pnpm-lock.yaml",
      "!.claude",
      "!apps/web/e2e/.auth",
      "!apps/web/test-results",
      "!apps/web/playwright-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "off",
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off",
        "useButtonType": "off",
        "noSvgWithoutTitle": "off",
        "noLabelWithoutControl": "off",
        "useSemanticElements": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "off",
        "noCommentText": "off"
      },
      "complexity": { "noImportantStyles": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": { "domains": { "react": "recommended", "playwright": "none" } }
    },
    {
      "includes": ["apps/web/e2e/**"],
      "linter": { "domains": { "react": "none", "playwright": "recommended" } }
    }
  ]
}
