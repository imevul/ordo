# ─── Ordo configuration ─────────────────────────────────────────────
# Copy to .env and adjust. `make up` creates .env from this file if missing.

# Port and interface Ordo is published on (host side). Use ORDO_BIND=127.0.0.1
# when a reverse proxy on the same machine terminates TLS.
ORDO_PORT=3000
ORDO_BIND=0.0.0.0

# The public URL users reach Ordo at. Used for invite links and to decide
# whether cookies are marked Secure (https:// => secure cookies).
ORDO_PUBLIC_URL=http://localhost:3000

# Who may create an account:
#   open   – anyone who can reach the instance can sign up
#   invite – only people holding an invite link (the very first user can always sign up)
ORDO_SIGNUP_MODE=invite

# Allow any signed-in user to create additional workspaces (true/false).
ORDO_ALLOW_WORKSPACE_CREATION=true

# Postgres credentials used by the bundled database container.
POSTGRES_USER=ordo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ordo

# Trust X-Forwarded-For from a reverse proxy (needed for per-IP rate limits behind
# a proxy). Set to false if Ordo is reachable directly, without a proxy in front.
ORDO_TRUST_PROXY=true

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
