# ─── Ordo configuration ─────────────────────────────────────────────
# Copy to .env and adjust. `make up` creates .env from this file if missing.

# Port and interface Ordo is published on (host side). Use ORDO_BIND=127.0.0.1
# when a reverse proxy on the same machine terminates TLS.
ORDO_PORT=3000
ORDO_BIND=0.0.0.0

# The public URL users reach Ordo at. Used for invite links and to decide
# whether cookies are marked Secure (https:// => secure cookies).
ORDO_PUBLIC_URL=http://localhost:3000

# Encrypts secrets Ordo stores (SSO client secrets, integration tokens). `make up` and
# `make update` generate one if this is empty. Keep it with your backups: without it,
# stored secrets can't be decrypted. To rotate, move the old value to
# ORDO_SECRET_KEY_PREVIOUS and set a new ORDO_SECRET_KEY.
ORDO_SECRET_KEY=
ORDO_SECRET_KEY_PREVIOUS=

# ─── Instance settings ──────────────────────────────────────────────
# These can also be changed by an instance admin in the app. Leave them empty to
# manage them there; a value here pins the setting and locks it in the UI.

# Who may create an account: open (anyone) or invite (invite links only; the very
# first user can always sign up). Default: invite.
ORDO_SIGNUP_MODE=

# Let users who already belong to a workspace create more (true/false). Default: true.
ORDO_ALLOW_WORKSPACE_CREATION=

# Let SSO discovery, webhooks and integrations reach private/LAN addresses, e.g. a
# self-hosted Keycloak or Forgejo on 10.x (true/false). Default: false.
ORDO_ALLOW_PRIVATE_NETWORK_TARGETS=

# Largest file people can attach, in megabytes (1–1024). Keep your reverse proxy's
# request body limit above it. Default: 25.
ORDO_MAX_ATTACHMENT_MB=

# Whether browsers keep an offline copy of each workspace: on (every device unless
# someone turns it off on theirs), optin (only where someone turns it on) or off. Default: on.
ORDO_OFFLINE_SYNC=

# Postgres credentials used by the bundled database container.
POSTGRES_USER=ordo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ordo
# Max database connections (one more is used for realtime). Default: 10.
DATABASE_POOL_SIZE=

# How many reverse proxies are in front of Ordo, for the client IP (per-IP rate limits, the
# audit log). false = none (the default): Ordo is reached directly. true = one; use 2 behind
# two (e.g. a CDN and nginx), or list their addresses. Only turn it on behind a proxy, and then
# also set ORDO_BIND=127.0.0.1 (or firewall the port) so nobody can reach Ordo around it.
ORDO_TRUST_PROXY=false

# ─── Email ──────────────────────────────────────────────────────────
# Needed for password resets, emailed invites and notification emails. Leave empty
# to configure it in Admin → Settings. Example: smtps://user:pass@smtp.example.com:465
ORDO_SMTP_URL=
ORDO_SMTP_FROM="Ordo <ordo@example.com>"

# ─── AI assistance (optional) ──────────────────────────────────────
# Off by default. anthropic (Claude API), openai (Ollama, vLLM… at ORDO_AI_BASE_URL)
# or off. Leave empty to configure it in Admin → Settings. See docs/ai.md.
ORDO_AI_PROVIDER=
ORDO_AI_MODEL=
ORDO_AI_BASE_URL=
ORDO_AI_API_KEY=
# What workspace admins may change: own (their own model, or off), instance (only
# turn it off) or locked (every workspace uses the instance's model). Default: own.
ORDO_WORKSPACE_AI=

# ─── Uploads ────────────────────────────────────────────────────────
# local (the ordo-data Docker volume) or s3 (any S3-compatible store: MinIO, Garage, R2…)
ORDO_STORAGE=local
ORDO_S3_ENDPOINT=
ORDO_S3_REGION=us-east-1
ORDO_S3_BUCKET=
ORDO_S3_ACCESS_KEY_ID=
ORDO_S3_SECRET_ACCESS_KEY=
ORDO_S3_FORCE_PATH_STYLE=true

# ─── GitHub Enterprise Server (optional) ───────────────────────────
# For the GitHub App flow. Empty means github.com; for Enterprise Server use
# https://github.example.com and https://github.example.com/api/v3.
ORDO_GITHUB_URL=
ORDO_GITHUB_API_URL=

# ─── Outgoing proxy (optional) ─────────────────────────────────────
# When the server reaches the internet only through an HTTP proxy. Used for building
# the image and for everything Ordo fetches: OAuth app metadata (MCP clients), SSO,
# webhooks, integrations, AI, push. Loopback always goes direct; add internal hosts
# (a LAN Forgejo, MinIO…) to NO_PROXY: comma-separated hosts or domains, * for all.
# Credentials go in the URL: http://user:pass@proxy.example.com:3128
#HTTP_PROXY=http://proxy.example.com:3128
#HTTPS_PROXY=http://proxy.example.com:3128
#NO_PROXY=.internal.example.com

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Tag for the locally built image. Default: latest.
#ORDO_VERSION=latest
