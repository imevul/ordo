{
  "name": "@ordo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ORDO_PUBLIC_URL=${ORDO_PUBLIC_URL-http://localhost:5173} ORDO_SMTP_URL=${ORDO_SMTP_URL-smtp://localhost:1025} ORDO_SMTP_FROM=${ORDO_SMTP_FROM-'Ordo dev <ordo@localhost>'} tsx watch --clear-screen=false src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fastify/websocket": "11.3.4",
    "@ordo/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "nodemailer": "10.2.1",
    "openid-client": "6.8.8",
    "otpauth": "9.5.2",
    "postgres": "3.4.9",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "jose": "6.2.13",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
