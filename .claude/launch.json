{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ordo/api",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ordo/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "ORDO_PREVIEW_API_PORT=3197 ORDO_PREVIEW_WEB_PORT=5197 pnpm dev:preview --ttl 40m"
      ],
      "port": 5197
    },
    {
      "name": "preview-2",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "ORDO_PREVIEW_API_PORT=3196 ORDO_PREVIEW_WEB_PORT=5196 pnpm dev:preview --ttl 30m"
      ],
      "port": 5196,
      "autoPort": false
    }
  ]
}
