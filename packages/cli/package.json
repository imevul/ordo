{
  "name": "@ordo/cli",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The ordo command: Ordo issues from the terminal",
  "type": "module",
  "exports": {
    ".": "./src/main.ts",
    "./agent": "./src/agent.ts"
  },
  "bin": {
    "ordo": "./dist/ordo.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "tsx src/bin.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ordo/sdk": "workspace:*",
    "@ordo/shared": "workspace:*",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
